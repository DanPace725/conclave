NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
CONCLAVE_MCP_ORIGIN=https://YOUR-CONCLAVE-HOST
CONCLAVE_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Explicit addresses restrict sign-in; * alone permits any verified account.
CONCLAVE_ALLOWED_EMAILS=you@example.com
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-ENDPOINT/neondb/auth
