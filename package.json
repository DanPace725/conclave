{
  "name": "conclave",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/cli.js chat",
    "demo": "node scripts/demo.js",
    "test": "node scripts/test.js",
    "evaluate": "node scripts/evaluate.js",
    "check": "node scripts/check.js",
    "serve": "node --env-file-if-exists=.env src/server.js",
    "sync:converse": "node scripts/sync-converse.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "mcp": "node packages/conclave-mcp/src/stdio.js",
    "mcp:serve": "node packages/conclave-mcp/src/http.js",
    "mcp:configs": "node packages/conclave-mcp/src/write-configs.js",
    "test:mcp": "node scripts/test.js packages/conclave-mcp/test/transport.test.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.9",
    "drizzle-orm": "^0.45.3",
    "gpt-tokenizer": "^4.0.0",
    "htmlparser2": "^12.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./*": "./src/*.js"
  }
}
